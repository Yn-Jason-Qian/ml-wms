# 复制为 .env.local 后按需修改（.env.local 已在 .gitignore 中，不会进仓库）

# 开发期后端地址：Vite dev server 的 /api 与 /ws-stomp 代理目标
# 默认 http://localhost:8080
VITE_DEV_PROXY_TARGET=

# 后端地址（不含 /api/v1）
# - H5 可以留空，走同源代理（dev server 代理 / nginx 反代）
# - 小程序、App 必填，且必须是可以访问的完整地址，例如 https://wms.example.com
VITE_API_BASE_URL=

# WebSocket 地址。留空时 H5 按同源推导 ws(s)://<当前域名>/ws-stomp
VITE_WS_BASE_URL=
