# ── WMS 环境变量示例 ──
#
# 用法: 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。
#
# 说明: 这些变量只在 prod profile 下生效（application-prod.yml 中有默认值）。
#       本地开发使用 dev profile（application-dev.yml 自带 localhost 配置），无需设置任何变量。

# 运行 profile: dev / prod
SPRING_PROFILES_ACTIVE=prod

# ── MySQL ──
# 注意保留 characterEncoding=UTF-8 与 connectionCollation，
# 否则中文会出现乱码（详见 deploy/README.md「字符集」一节）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ml_wms?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&sslMode=DISABLED&allowPublicKeyRetrieval=true&tinyInt1isBit=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# ── Redis ──
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── ID 混淆 ──
# 接口返回的 ID 由该盐值混淆；生产环境务必修改。
# 注意: 修改后已签发/已缓存的 ID 将无法解析。
HASHIDS_SALT=change-me-too
HASHIDS_MIN_LENGTH=8
