# ── WMS 部署配置模板 ──
#
# 用法：复制到部署目录并改名
#     cp /opt/wms/.env.example /opt/wms/.env
#     vi /opt/wms/.env
#
# deploy.sh 与 docker compose 读的是同一个文件（/opt/wms/.env），
# 所有项都可以省略 —— 省略时使用下面注释里标注的默认值。

# ── 已有的基础设施容器（本部署只复用，不接管）──
# 默认: mysql8 / redis7
WMS_DB_CONTAINER=mysql8
WMS_REDIS_CONTAINER=redis7

# ── 后端连接参数 ──
# WMS_DB_HOST / WMS_REDIS_HOST 留空时自动取上面的容器名
# （同一个 docker 网络内可以直接用容器名互访）。
# 数据库不在 docker 网络内时（例如宿主机或云数据库），在这里写实际地址。
# WMS_DB_HOST=mysql8
# WMS_DB_PORT=3306
# WMS_REDIS_HOST=redis7
# WMS_REDIS_PORT=6379

# 数据库名，默认 ml_wms
# WMS_DB_NAME=ml_wms

# ── 数据库口令 ──
# 默认: root / root
MYSQL_USER=root
MYSQL_PASSWORD=root

# ── Docker 网络名 ──
# 留空时由 deploy.sh 自动探测（从 mysql 容器反查），探测失败才退化为 backend。
# 一般不需要设置。
# WMS_NET=myproject_backend

# ── 发布与回滚（deploy.sh / rollback.sh）──
# 发布记录保留条数，同时也是可回滚的深度上限（默认 10）。
# 每条记录对应一组镜像 tag，删掉的记录其镜像也会被清理。
# WMS_KEEP_RELEASES=10

# 本地保留的 wms-web-*.jar 份数（默认 5）。只影响磁盘占用，回滚走镜像不走 jar。
# WMS_KEEP_JARS=5

# 健康检查失败时是否自动回滚到上一个发布：1 = 自动回滚（默认），0 = 只报错不回滚。
# WMS_ROLLBACK_ON_FAILURE=1

# 发布后探测的地址与节奏，默认 40 次 × 3 秒 = 120 秒。
# 后端启动慢（机器性能差、库大）时调大 WMS_HEALTH_TRIES 即可。
# WMS_SERVER_HEALTH_URL=http://127.0.0.1:8080/doc.html
# WMS_WEB_HEALTH_URL=http://127.0.0.1/
# WMS_HEALTH_TRIES=40
# WMS_HEALTH_INTERVAL=3

# 容器内的健康检查命令（docker healthcheck 用），默认依赖镜像里的 wget。
# 只在 docker ps 里体现健康状态，不影响发布成败判定（那个由上面的 URL 决定）。
# 注意：本文件会被 shell source，值里有空格必须加引号。镜像里没有 wget 时可换成 curl：
# WMS_SERVER_HEALTH_CMD="curl -fsS -o /dev/null http://127.0.0.1:8080/doc.html || exit 1"
# WMS_WEB_HEALTH_CMD="curl -fsS -o /dev/null http://127.0.0.1/ || exit 1"
