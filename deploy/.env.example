# ── WMS 部署配置模板 ──
#
# 用法：复制到部署目录并改名
#     cp /opt/wms/.env.example /opt/wms/.env
#     vi /opt/wms/.env
#
# deploy.sh 与 docker compose 读的是同一个文件（/opt/wms/.env），
# 所有项都可以省略 —— 省略时使用下面注释里标注的默认值。

# ── 已有的基础设施容器（本部署只复用，不接管）──
# 默认: mysql8 / redis7
WMS_DB_CONTAINER=mysql8
WMS_REDIS_CONTAINER=redis7

# ── 后端连接参数 ──
# WMS_DB_HOST / WMS_REDIS_HOST 留空时自动取上面的容器名
# （同一个 docker 网络内可以直接用容器名互访）。
# 数据库不在 docker 网络内时（例如宿主机或云数据库），在这里写实际地址。
# WMS_DB_HOST=mysql8
# WMS_DB_PORT=3306
# WMS_REDIS_HOST=redis7
# WMS_REDIS_PORT=6379

# 数据库名，默认 ml_wms
# WMS_DB_NAME=ml_wms

# ── 数据库口令 ──
# 默认: root / root
MYSQL_USER=root
MYSQL_PASSWORD=root

# ── Docker 网络名 ──
# 留空时由 deploy.sh 自动探测（从 mysql 容器反查），探测失败才退化为 backend。
# 一般不需要设置。
# WMS_NET=myproject_backend
